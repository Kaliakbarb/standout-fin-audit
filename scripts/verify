#!/usr/bin/env python3
"""Run tests and milestone acceptance offline in the supported secure container."""

import argparse
import subprocess
import sys
import tempfile
from pathlib import Path

# A verified release is immutable, including the absence of import caches.
sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[1]

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--offline", action="store_true", help="Explicit offline mode; runtime never downloads regardless.")
parser.add_argument("--context")
parser.add_argument("--image-archive", type=Path)
parser.add_argument("--output", type=Path)
parser.add_argument("--release-bundle", action="store_true", help="Require the immutable release manifest and pinned archive.")
parser.add_argument("--stage", type=int, choices=[1, 2, 3, 4, 5], default=5)
parser.add_argument("--seed-file", type=Path,
                    help="Private host receipt; reused to reproduce the same control cohort.")
args = parser.parse_args()
try:
    release = None
    if args.release_bundle or (ROOT / "release-manifest.json").exists() or (ROOT / "release-manifest.json").is_symlink():
        from release_support import load_verified_image, verify_bundle
        release = verify_bundle(ROOT)
    # A forced release validates its complete inventory before importing helpers
    # which read project metadata. Missing files produce a bounded release error.
    from docker_common import IMAGE, docker_command, load_or_create_master_seed, run_secure_container
    docker = docker_command(args.context)
    image = IMAGE
    if release is not None:
        # Always import the checked archive, even if an unrelated cached tag is
        # present. All executions use the verified immutable image ID.
        if args.image_archive is not None and args.image_archive.resolve() != (ROOT / release["runtime"]["archive"]).resolve():
            raise ValueError("Release mode uses only its manifest-verified image archive.")
        release = load_verified_image(ROOT, docker)
        image = release["loaded_image_id"]
    else:
        present = subprocess.run(docker + ["image", "inspect", image], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if present.returncode:
            if args.image_archive is None:
                raise RuntimeError("Prepared image is missing. Run ./scripts/prepare online first or supply --image-archive. No pull is attempted.")
            subprocess.run(docker + ["image", "load", "-i", str(args.image_archive.resolve())], check=True)
            subprocess.run(docker + ["image", "inspect", image], check=True, stdout=subprocess.DEVNULL)
    if args.output:
        output = args.output.absolute()
        if release is not None and output.resolve().is_relative_to(ROOT):
            raise ValueError("Release verification output must be outside the immutable bundle.")
        output.mkdir(mode=0o700, parents=True, exist_ok=False)
        output.chmod(0o700)
    else:
        artifacts = ROOT.parent / f"{ROOT.name}-verification" if release is not None else ROOT / "artifacts"
        artifacts.mkdir(exist_ok=True)
        output = Path(tempfile.mkdtemp(prefix="secure-", dir=artifacts))
    command = ["python", "scripts/container_verify.py", "--stage", str(args.stage), "--output", "/output"]
    if args.stage >= 3:
        seed_file = args.seed_file or ((ROOT.parent / f".{ROOT.name}-protocol-master-seed.json") if release is not None else ROOT / "artifacts" / ".protocol-master-seed.json")
        if release is not None and seed_file.resolve().is_relative_to(ROOT):
            raise ValueError("Release seed receipt must be outside the immutable bundle.")
        command.extend(["--master-seed", str(load_or_create_master_seed(seed_file))])
    status = run_secure_container(docker, image, command, output, cwd=ROOT,
                                  platform="linux/" + release["runtime"]["architecture"] if release else None)
    print(f"Verification artifacts: {output}", flush=True)
    raise SystemExit(status)
except KeyboardInterrupt:
    print("Verification interrupted; owned container and volume cleanup attempted.", file=sys.stderr)
    raise SystemExit(130)
except subprocess.TimeoutExpired:
    # TimeoutExpired.__str__ includes command arguments, including private seeds.
    print("Verification failed: Docker operation timed out; owned cleanup attempted.", file=sys.stderr)
    raise SystemExit(1)
except (ValueError, RuntimeError, OSError, subprocess.SubprocessError) as error:
    print(f"Verification failed: {error}", file=sys.stderr)
    raise SystemExit(1)
